# Dependencies
node_modules/

# Local Android/Java toolchain (JDK, SDK, Gradle — regenerated by CI, not committed)
toolchain/

# Android build outputs
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/captures/
*.apk
*.aab

# Android signing — NEVER commit keystore or its password
android/keystore/
android/keystore.properties

# iOS build outputs
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/
*.ipa

# iOS signing — NEVER commit certificates or provisioning profiles
*.p12
*.mobileprovision
*.cer

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
